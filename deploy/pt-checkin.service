[Unit]
Description=PT 站点每日自动签到服务 (pt-checkin)
Documentation=file:///opt/pt-checkin/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ptcheckin
Group=ptcheckin
WorkingDirectory=/opt/pt-checkin
Environment=PTCHECKIN_DATA=/var/lib/pt-checkin
Environment=PTCHECKIN_HOST=127.0.0.1
Environment=PTCHECKIN_PORT=8787
Environment=TZ=Asia/Shanghai
ExecStart=/usr/bin/python3 /opt/pt-checkin/run.py serve
Restart=always
RestartSec=10
# 优雅停止
KillSignal=SIGINT
TimeoutStopSec=20

# --- 安全加固 ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pt-checkin
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
